[128.974, "o", "\u001b[90m┌─ auth_service.py · csrf_protected() ──────────────────────────────────────────────────────────────────\u001b[0m\n"]
[128.974, "o", "\u001b[90m 102\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mcsrf_protected\u001b[39;49;00m(f):\u001b[90m\u001b[39;49;00m\n"]
[129.029, "o", "\u001b[90m 103\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[129.084, "o", "\u001b[90m 104\u001b[0m\u001b[90m │ \u001b[0m    Decorador de protección CSRF básica para endpoints POST/PUT/DELETE.\u001b[90m\u001b[39;49;00m\n"]
[129.139, "o", "\u001b[90m 105\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[129.194, "o", "\u001b[90m 106\u001b[0m\u001b[90m │ \u001b[0m    Verifica que:\u001b[90m\u001b[39;49;00m\n"]
[129.249, "o", "\u001b[90m 107\u001b[0m\u001b[90m │ \u001b[0m      \u001b[94m1.\u001b[39;49;00m El header \u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00mContent-Type\u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m incluya \u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00mapplication/json\u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m.\u001b[90m\u001b[39;49;00m\n"]
[129.304, "o", "\u001b[90m 108\u001b[0m\u001b[90m │ \u001b[0m      \u001b[94m2.\u001b[39;49;00m El header \u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00mX-Requested-With\u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m sea \u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00mXMLHttpRequest\u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m.\u001b[90m\u001b[39;49;00m\n"]
[129.359, "o", "\u001b[90m 109\u001b[0m\u001b[90m │ \u001b[0m      \u001b[94m3.\u001b[39;49;00m El header \u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00mOrigin\u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m o \u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00mReferer\u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m coincida con el origen \u001b[94mdel\u001b[39;49;00m servidor.\u001b[90m\u001b[39;49;00m\n"]
[129.414, "o", "\u001b[90m 110\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[129.469, "o", "\u001b[90m 111\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[129.524, "o", "\u001b[90m 112\u001b[0m\u001b[90m │ \u001b[0m    \u001b[37m@wraps\u001b[39;49;00m(f)\u001b[90m\u001b[39;49;00m\n"]
[129.579, "o", "\u001b[90m 113\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mdecorated_function\u001b[39;49;00m(*args, **kwargs):\u001b[90m\u001b[39;49;00m\n"]
[129.634, "o", "\u001b[90m 114\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# 1. Verificar Content-Type\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[129.689, "o", "\u001b[90m 115\u001b[0m\u001b[90m │ \u001b[0m        content_type = request.headers.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mContent-Type\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[129.744, "o", "\u001b[90m 116\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mapplication/json\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[95min\u001b[39;49;00m content_type:\u001b[90m\u001b[39;49;00m\n"]
[129.799, "o", "\u001b[90m 117\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m jsonify({\u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mContent-Type debe ser application/json\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m}), \u001b[94m400\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[129.854, "o", "\u001b[90m 118\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[129.909, "o", "\u001b[90m 119\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# 2. Verificar X-Requested-With\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[129.964, "o", "\u001b[90m 120\u001b[0m\u001b[90m │ \u001b[0m        requested_with = request.headers.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mX-Requested-With\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[130.019, "o", "\u001b[90m 121\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m requested_with != \u001b[33m\"\u001b[39;49;00m\u001b[33mXMLHttpRequest\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[130.074, "o", "\u001b[90m 122\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m jsonify({\u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mHeader X-Requested-With requerido\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m}), \u001b[94m400\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[130.129, "o", "\u001b[90m 123\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[130.184, "o", "\u001b[90m 124\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# 3. Verificar Origin/Referer contra el servidor\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[130.239, "o", "\u001b[90m 125\u001b[0m\u001b[90m │ \u001b[0m        origin = request.headers.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mOrigin\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[130.294, "o", "\u001b[90m 126\u001b[0m\u001b[90m │ \u001b[0m        referer = request.headers.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mReferer\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[130.349, "o", "\u001b[90m 127\u001b[0m\u001b[90m │ \u001b[0m        server_origin = request.host_url.rstrip(\u001b[33m\"\u001b[39;49;00m\u001b[33m/\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[130.404, "o", "\u001b[90m 128\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[130.459, "o", "\u001b[90m 129\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m origin \u001b[95mand\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m origin.startswith(server_origin):\u001b[90m\u001b[39;49;00m\n"]
[130.514, "o", "\u001b[90m 130\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m jsonify({\u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mOrigen no permitido\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m}), \u001b[94m400\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[130.569, "o", "\u001b[90m 131\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m referer \u001b[95mand\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m referer.startswith(server_origin):\u001b[90m\u001b[39;49;00m\n"]
[130.624, "o", "\u001b[90m 132\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m jsonify({\u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mReferer no permitido\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m}), \u001b[94m400\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[130.679, "o", "\u001b[90m 133\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
