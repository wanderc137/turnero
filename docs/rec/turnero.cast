[112.514, "o", "\u001b[90m┌─ routes/api.py · stream SSE ──────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[112.514, "o", "\u001b[90m 125\u001b[0m\u001b[90m │ \u001b[0m\u001b[37m@api_bp\u001b[39;49;00m.route(\u001b[33m\"\u001b[39;49;00m\u001b[33m/api/turnos/eventos\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[112.569, "o", "\u001b[90m 126\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mturnos_eventos\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\n"]
[112.624, "o", "\u001b[90m 127\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[112.679, "o", "\u001b[90m 128\u001b[0m\u001b[90m │ \u001b[0m    Endpoint SSE (Server-Sent Events).\u001b[90m\u001b[39;49;00m\n"]
[112.734, "o", "\u001b[90m 129\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[112.789, "o", "\u001b[90m 130\u001b[0m\u001b[90m │ \u001b[0m    Mantiene la conexión abierta y emite eventos cuando:\u001b[90m\u001b[39;49;00m\n"]
[112.844, "o", "\u001b[90m 131\u001b[0m\u001b[90m │ \u001b[0m      - Un turno es creado (turno_creado)\u001b[90m\u001b[39;49;00m\n"]
[112.899, "o", "\u001b[90m 132\u001b[0m\u001b[90m │ \u001b[0m      - Un turno es llamado (turno_llamado)\u001b[90m\u001b[39;49;00m\n"]
[112.954, "o", "\u001b[90m 133\u001b[0m\u001b[90m │ \u001b[0m      - Un turno comienza a ser atendido (turno_atendido)\u001b[90m\u001b[39;49;00m\n"]
[113.009, "o", "\u001b[90m 134\u001b[0m\u001b[90m │ \u001b[0m      - Un turno es finalizado (turno_finalizado)\u001b[90m\u001b[39;49;00m\n"]
[113.064, "o", "\u001b[90m 135\u001b[0m\u001b[90m │ \u001b[0m      - Un ejecutivo cierra sesión (ejecutivo_logout)\u001b[90m\u001b[39;49;00m\n"]
[113.119, "o", "\u001b[90m 136\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[113.174, "o", "\u001b[90m 137\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[113.229, "o", "\u001b[90m 138\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mevent_stream\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\n"]
[113.284, "o", "\u001b[90m 139\u001b[0m\u001b[90m │ \u001b[0m        q = register_listener()\u001b[90m\u001b[39;49;00m\n"]
[113.339, "o", "\u001b[90m 140\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[113.394, "o", "\u001b[90m 141\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# Enviar heartbeat cada 30 segundos para mantener conexión\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[113.449, "o", "\u001b[90m 142\u001b[0m\u001b[90m │ \u001b[0m            last_heartbeat = time.time()\u001b[90m\u001b[39;49;00m\n"]
[113.504, "o", "\u001b[90m 143\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mwhile\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[113.559, "o", "\u001b[90m 144\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# Intentar obtener un evento (timeout para poder enviar heartbeat)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[113.614, "o", "\u001b[90m 145\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[113.669, "o", "\u001b[90m 146\u001b[0m\u001b[90m │ \u001b[0m                    payload = q.get(timeout=\u001b[94m5\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[113.724, "o", "\u001b[90m 147\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[94myield\u001b[39;49;00m \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mdata: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mpayload\u001b[33m}\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[113.779, "o", "\u001b[90m 148\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mexcept\u001b[39;49;00m queue.Empty:\u001b[90m\u001b[39;49;00m\n"]
[113.834, "o", "\u001b[90m 149\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[90m# Enviar heartbeat si han pasado 30 segundos\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[113.889, "o", "\u001b[90m 150\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[94mif\u001b[39;49;00m time.time() - last_heartbeat >= \u001b[94m30\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[113.944, "o", "\u001b[90m 151\u001b[0m\u001b[90m │ \u001b[0m                        \u001b[94myield\u001b[39;49;00m \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m: heartbeat\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[113.999, "o", "\u001b[90m 152\u001b[0m\u001b[90m │ \u001b[0m                        last_heartbeat = time.time()\u001b[90m\u001b[39;49;00m\n"]
[114.054, "o", "\u001b[90m 153\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[94mcontinue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[114.109, "o", "\u001b[90m 154\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mexcept\u001b[39;49;00m \u001b[96mGeneratorExit\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[114.164, "o", "\u001b[90m 155\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mpass\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[114.219, "o", "\u001b[90m 156\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfinally\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[114.274, "o", "\u001b[90m 157\u001b[0m\u001b[90m │ \u001b[0m            unregister_listener(q)\u001b[90m\u001b[39;49;00m\n"]
[114.329, "o", "\u001b[90m 158\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[114.384, "o", "\u001b[90m 159\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m Response(\u001b[90m\u001b[39;49;00m\n"]
[114.439, "o", "\u001b[90m 160\u001b[0m\u001b[90m │ \u001b[0m        stream_with_context(event_stream()),\u001b[90m\u001b[39;49;00m\n"]
[114.494, "o", "\u001b[90m 161\u001b[0m\u001b[90m │ \u001b[0m        mimetype=\u001b[33m\"\u001b[39;49;00m\u001b[33mtext/event-stream\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[114.549, "o", "\u001b[90m 162\u001b[0m\u001b[90m │ \u001b[0m        headers={\u001b[90m\u001b[39;49;00m\n"]
[114.604, "o", "\u001b[90m 163\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mCache-Control\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mno-cache\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[114.659, "o", "\u001b[90m 164\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mConnection\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mkeep-alive\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[114.714, "o", "\u001b[90m 165\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mX-Accel-Buffering\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mno\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
