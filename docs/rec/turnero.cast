[80.681, "o", "\u001b[90m┌─ turno_service.py · llamar_siguiente() ───────────────────────────────────────────────────────────────\u001b[0m\n"]
[80.681, "o", "\u001b[90m 104\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mllamar_siguiente\u001b[39;49;00m(ejecutivo_id: \u001b[96mint\u001b[39;49;00m) -> Turno | \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[80.736, "o", "\u001b[90m 105\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[80.791, "o", "\u001b[90m 106\u001b[0m\u001b[90m │ \u001b[0m    Asigna el siguiente turno en espera al modulo \u001b[94mdel\u001b[39;49;00m ejecutivo.\u001b[90m\u001b[39;49;00m\n"]
[80.846, "o", "\u001b[90m 107\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[80.901, "o", "\u001b[90m 108\u001b[0m\u001b[90m │ \u001b[0m    - Busca el turno mas antiguo en estado \u001b[33m'\u001b[39;49;00m\u001b[33mesperando\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m (FIFO).\u001b[90m\u001b[39;49;00m\n"]
[80.956, "o", "\u001b[90m 109\u001b[0m\u001b[90m │ \u001b[0m    - Cambia su estado a \u001b[33m'\u001b[39;49;00m\u001b[33mllamado\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m.\u001b[90m\u001b[39;49;00m\n"]
[81.011, "o", "\u001b[90m 110\u001b[0m\u001b[90m │ \u001b[0m    - Asigna modulo_id y ejecutivo_id.\u001b[90m\u001b[39;49;00m\n"]
[81.066, "o", "\u001b[90m 111\u001b[0m\u001b[90m │ \u001b[0m    - Registra fecha_llamado.\u001b[90m\u001b[39;49;00m\n"]
[81.121, "o", "\u001b[90m 112\u001b[0m\u001b[90m │ \u001b[0m    - Retorna el turno asignado o \u001b[94mNone\u001b[39;49;00m si no hay turnos.\u001b[90m\u001b[39;49;00m\n"]
[81.176, "o", "\u001b[90m 113\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[81.231, "o", "\u001b[90m 114\u001b[0m\u001b[90m │ \u001b[0m    ejecutivo = Ejecutivo.query.get(ejecutivo_id)\u001b[90m\u001b[39;49;00m\n"]
[81.286, "o", "\u001b[90m 115\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m ejecutivo:\u001b[90m\u001b[39;49;00m\n"]
[81.341, "o", "\u001b[90m 116\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mraise\u001b[39;49;00m \u001b[96mValueError\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mEjecutivo no encontrado\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[81.396, "o", "\u001b[90m 117\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[81.451, "o", "\u001b[90m 118\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Verificar que el ejecutivo no tenga ya un turno activo\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[81.506, "o", "\u001b[90m 119\u001b[0m\u001b[90m │ \u001b[0m    turno_activo = Turno.query.filter(\u001b[90m\u001b[39;49;00m\n"]
[81.561, "o", "\u001b[90m 120\u001b[0m\u001b[90m │ \u001b[0m        Turno.ejecutivo_id == ejecutivo_id,\u001b[90m\u001b[39;49;00m\n"]
[81.616, "o", "\u001b[90m 121\u001b[0m\u001b[90m │ \u001b[0m        Turno.estado.in_([\u001b[33m\"\u001b[39;49;00m\u001b[33mllamado\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33men_atencion\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]),\u001b[90m\u001b[39;49;00m\n"]
