[51.92, "o", "\u001b[90m┌─ turno_service.py · validar_rut() ────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[51.92, "o", "\u001b[90m  36\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mvalidar_rut\u001b[39;49;00m(rut: \u001b[96mstr\u001b[39;49;00m) -> \u001b[96mbool\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[51.975, "o", "\u001b[90m  37\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[52.03, "o", "\u001b[90m  38\u001b[0m\u001b[90m │ \u001b[0m    Valida un RUT chileno usando el algoritmo \u001b[94mdel\u001b[39;49;00m dígito verificador (módulo \u001b[94m11\u001b[39;49;00m).\u001b[90m\u001b[39;49;00m\n"]
[52.085, "o", "\u001b[90m  39\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[52.14, "o", "\u001b[90m  40\u001b[0m\u001b[90m │ \u001b[0m    Pasos:\u001b[90m\u001b[39;49;00m\n"]
[52.195, "o", "\u001b[90m  41\u001b[0m\u001b[90m │ \u001b[0m      \u001b[94m1.\u001b[39;49;00m Limpia el RUT (quita puntos, guión, espacios).\u001b[90m\u001b[39;49;00m\n"]
[52.25, "o", "\u001b[90m  42\u001b[0m\u001b[90m │ \u001b[0m      \u001b[94m2.\u001b[39;49;00m Separa cuerpo y dígito verificador.\u001b[90m\u001b[39;49;00m\n"]
[52.305, "o", "\u001b[90m  43\u001b[0m\u001b[90m │ \u001b[0m      \u001b[94m3.\u001b[39;49;00m Calcula el dígito verificador esperado.\u001b[90m\u001b[39;49;00m\n"]
[52.36, "o", "\u001b[90m  44\u001b[0m\u001b[90m │ \u001b[0m      \u001b[94m4.\u001b[39;49;00m Compara con el dígito ingresado.\u001b[90m\u001b[39;49;00m\n"]
[52.415, "o", "\u001b[90m  45\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[52.47, "o", "\u001b[90m  46\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Limpiar: quitar puntos, guiones, espacios\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[52.525, "o", "\u001b[90m  47\u001b[0m\u001b[90m │ \u001b[0m    limpio = rut.replace(\u001b[33m\"\u001b[39;49;00m\u001b[33m.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).replace(\u001b[33m\"\u001b[39;49;00m\u001b[33m-\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).replace(\u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).strip()\u001b[90m\u001b[39;49;00m\n"]
[52.58, "o", "\u001b[90m  48\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[52.635, "o", "\u001b[90m  49\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(limpio) < \u001b[94m2\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[52.69, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[94mFalse\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[52.745, "o", "\u001b[90m  51\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[52.8, "o", "\u001b[90m  52\u001b[0m\u001b[90m │ \u001b[0m    cuerpo = limpio[:-\u001b[94m1\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n"]
[52.855, "o", "\u001b[90m  53\u001b[0m\u001b[90m │ \u001b[0m    dv_ingresado = limpio[-\u001b[94m1\u001b[39;49;00m].upper()\u001b[90m\u001b[39;49;00m\n"]
[52.91, "o", "\u001b[90m  54\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[52.965, "o", "\u001b[90m  55\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m cuerpo.isdigit():\u001b[90m\u001b[39;49;00m\n"]
[53.02, "o", "\u001b[90m  56\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[94mFalse\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[53.075, "o", "\u001b[90m  57\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[53.13, "o", "\u001b[90m  58\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Calcular dígito verificador (módulo 11)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[53.185, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m    suma = \u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[53.24, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m    multiplicador = \u001b[94m2\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[53.295, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mfor\u001b[39;49;00m digito \u001b[95min\u001b[39;49;00m \u001b[96mreversed\u001b[39;49;00m(cuerpo):\u001b[90m\u001b[39;49;00m\n"]
[53.35, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0m        suma += \u001b[96mint\u001b[39;49;00m(digito) * multiplicador\u001b[90m\u001b[39;49;00m\n"]
[53.405, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m        multiplicador = \u001b[94m2\u001b[39;49;00m \u001b[94mif\u001b[39;49;00m multiplicador == \u001b[94m7\u001b[39;49;00m \u001b[94melse\u001b[39;49;00m multiplicador + \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[53.46, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[53.515, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m    resto = suma % \u001b[94m11\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[53.57, "o", "\u001b[90m  66\u001b[0m\u001b[90m │ \u001b[0m    dv_calculado = \u001b[94m11\u001b[39;49;00m - resto\u001b[90m\u001b[39;49;00m\n"]
[53.625, "o", "\u001b[90m  67\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m dv_calculado == \u001b[94m11\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[53.68, "o", "\u001b[90m  68\u001b[0m\u001b[90m │ \u001b[0m        dv_calculado = \u001b[33m\"\u001b[39;49;00m\u001b[33m0\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[53.735, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94melif\u001b[39;49;00m dv_calculado == \u001b[94m10\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[53.79, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m        dv_calculado = \u001b[33m\"\u001b[39;49;00m\u001b[33mK\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[53.845, "o", "\u001b[90m  71\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[53.9, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m        dv_calculado = \u001b[96mstr\u001b[39;49;00m(dv_calculado)\u001b[90m\u001b[39;49;00m\n"]
[53.955, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[54.01, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m dv_calculado == dv_ingresado\u001b[90m\u001b[39;49;00m\n"]
[54.065, "o", "\u001b[90m└───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
