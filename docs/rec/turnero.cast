[96.535, "o", "\u001b[90m┌─ turno_service.py · iniciar_atencion() ───────────────────────────────────────────────────────────────\u001b[0m\n"]
[96.535, "o", "\u001b[90m 144\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92miniciar_atencion\u001b[39;49;00m(qr_token: \u001b[96mstr\u001b[39;49;00m, ejecutivo_id: \u001b[96mint\u001b[39;49;00m) -> Turno | \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[96.59, "o", "\u001b[90m 145\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[96.645, "o", "\u001b[90m 146\u001b[0m\u001b[90m │ \u001b[0m    Inicia la atencion de un turno escaneando su QR.\u001b[90m\u001b[39;49;00m\n"]
[96.7, "o", "\u001b[90m 147\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[96.755, "o", "\u001b[90m 148\u001b[0m\u001b[90m │ \u001b[0m    - Busca turno por qr_token.\u001b[90m\u001b[39;49;00m\n"]
[96.81, "o", "\u001b[90m 149\u001b[0m\u001b[90m │ \u001b[0m    - Verifica que el turno este en estado \u001b[33m'\u001b[39;49;00m\u001b[33mllamado\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m.\u001b[90m\u001b[39;49;00m\n"]
[96.865, "o", "\u001b[90m 150\u001b[0m\u001b[90m │ \u001b[0m    - Verifica que pertenezca al ejecutivo que lo escanea.\u001b[90m\u001b[39;49;00m\n"]
[96.92, "o", "\u001b[90m 151\u001b[0m\u001b[90m │ \u001b[0m    - Cambia estado a \u001b[33m'\u001b[39;49;00m\u001b[33men_atencion\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m.\u001b[90m\u001b[39;49;00m\n"]
[96.975, "o", "\u001b[90m 152\u001b[0m\u001b[90m │ \u001b[0m    - Registra fecha_inicio_atencion.\u001b[90m\u001b[39;49;00m\n"]
[97.03, "o", "\u001b[90m 153\u001b[0m\u001b[90m │ \u001b[0m    - Retorna el turno o \u001b[94mNone\u001b[39;49;00m si no se encuentra.\u001b[90m\u001b[39;49;00m\n"]
[97.085, "o", "\u001b[90m 154\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[97.14, "o", "\u001b[90m 155\u001b[0m\u001b[90m │ \u001b[0m    turno = Turno.query.filter_by(qr_token=qr_token).first()\u001b[90m\u001b[39;49;00m\n"]
[97.195, "o", "\u001b[90m 156\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m turno:\u001b[90m\u001b[39;49;00m\n"]
[97.25, "o", "\u001b[90m 157\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.305, "o", "\u001b[90m 158\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[97.36, "o", "\u001b[90m 159\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m turno.estado != \u001b[33m\"\u001b[39;49;00m\u001b[33mllamado\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[97.415, "o", "\u001b[90m 160\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mraise\u001b[39;49;00m \u001b[96mValueError\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[97.47, "o", "\u001b[90m 161\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mEl turno \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mturno.codigo\u001b[33m}\u001b[39;49;00m\u001b[33m no esta en estado \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mllamado\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.525, "o", "\u001b[90m 162\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m(actual: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mturno.estado\u001b[33m}\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.58, "o", "\u001b[90m 163\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
[97.635, "o", "\u001b[90m 164\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m turno.ejecutivo_id != ejecutivo_id:\u001b[90m\u001b[39;49;00m\n"]
[97.69, "o", "\u001b[90m 165\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mraise\u001b[39;49;00m \u001b[96mValueError\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[97.745, "o", "\u001b[90m 166\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mEste turno fue llamado por otro ejecutivo\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.8, "o", "\u001b[90m 167\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
[97.855, "o", "\u001b[90m 168\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[97.91, "o", "\u001b[90m 169\u001b[0m\u001b[90m │ \u001b[0m    turno.estado = \u001b[33m\"\u001b[39;49;00m\u001b[33men_atencion\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.965, "o", "\u001b[90m 170\u001b[0m\u001b[90m │ \u001b[0m    turno.fecha_inicio_atencion = datetime.now(timezone.utc)\u001b[90m\u001b[39;49;00m\n"]
[98.02, "o", "\u001b[90m 171\u001b[0m\u001b[90m │ \u001b[0m    db.session.commit()\u001b[90m\u001b[39;49;00m\n"]
[98.075, "o", "\u001b[90m 172\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m turno\u001b[90m\u001b[39;49;00m\n"]
